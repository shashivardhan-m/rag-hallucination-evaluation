# ==============================================================================
# RAG Hallucination Evaluation System - Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="RAG Hallucination Evaluator"
DEBUG=false
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# LLM Provider API Keys & URLs
# Groq API Key (get from https://console.groq.com)
GROQ_API_KEY=""

# OpenAI API Key (optional, if using OpenAI backend)
OPENAI_API_KEY=""

# Ollama Base URL (optional, for local LLM inference)
OLLAMA_BASE_URL="http://localhost:11434"

# HuggingFace Model ID for local generation fallback
HF_MODEL_ID="TinyLlama/TinyLlama-1.1B-Chat-v1.0"

# Default Execution Settings
DEFAULT_LLM_BACKEND="groq"          # Options: groq, openai, ollama, huggingface
DEFAULT_GROQ_MODEL="llama3-8b-8192" # Groq model id

# Embedding & Reranker Models
EMBEDDING_MODEL="BAAI/bge-base-en-v1.5"
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"

# Storage & Database Paths (relative to backend or absolute)
FAISS_INDEX_PATH="data/faiss_index"
UPLOADS_PATH="data/uploads"
EXPERIMENTS_PATH="data/experiments"
DATABASE_URL="sqlite:///./data/research.db"

# RAG Defaults
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=128
DEFAULT_TOP_K=5
MAX_FILE_SIZE_MB=50
